table ai_insights_weekly
	lineageTag: 43083430-6555-40ea-9933-a6cdd7574519

	measure 'Narratives Verified' = COUNTROWS(FILTER(ai_insights_weekly, ai_insights_weekly[status] = "verified"))
		formatString: 0
		lineageTag: 7507b1c8-bdce-4a87-a781-cebe8b0d7ee5

	measure 'Facts Verified %' = DIVIDE(SUM(ai_insights_weekly[facts_verified]), SUM(ai_insights_weekly[facts_total]))
