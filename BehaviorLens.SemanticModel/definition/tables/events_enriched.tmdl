table events_enriched
	lineageTag: 855420cb-93de-4ad2-823b-f75ef3b96468

	measure 'Sessions per Step' = DISTINCTCOUNT(events_enriched[sessionId])
		formatString: #,##0
		lineageTag: d10d46d1-9cdb-4877-b96a-a0057d9dc206

	measure 'Total Events' = COUNTROWS(events_enriched)
		formatString: #,##0
		lineageTag: 7d4a836c-827e-4357-a809-e1183a7fd2e1

