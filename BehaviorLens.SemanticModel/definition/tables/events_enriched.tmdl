	column event_date = DATE(YEAR(events_enriched[event_timestamp]), MONTH(events_enriched[event_timestamp]), DAY(events_enriched[event_timestamp]))
		dataType: dateTime
		formatString: Long Date
		lineageTag: f3eec992-c955-45ae-a3b8-427ec4229af6

	column flow =
			SWITCH(TRUE(),
			  events_enriched[eventName] IN {"login_attempt","login_success","onboarding_step_complete"}, "Login & Onboarding",
			  events_enriched[eventName] IN {"feature_click","search_query","filter_applied","export_triggered"}, "Feature Usage",
			  events_enriched[eventName] IN {"api_error","page_not_found","retry_attempt"}, "Error & Recovery",
			  "Other"
			)
		dataType: string
		lineageTag: 95f73d41-8146-4afc-9ed3-12f5870e0f7a

	column flow_step =
			SWITCH(events_enriched[eventName],
			  "login_attempt", 1, "login_success", 2, "onboarding_step_complete", 3,
			  "feature_click", 1, "search_query", 2, "filter_applied", 3, "export_triggered", 4,
			  "api_error", 1, "page_not_found", 2, "retry_attempt", 3,
			  0
			)
		dataType: int64
		formatString: 0
		displayFolder: Journey
		lineageTag: 20df3166-3d1a-4a61-a0d9-b07d83a82e35

	partition events_enriched = m
		mode: import
		source =
				let
				    Source = DatabricksMultiCloud.Catalogs("dbc-6051f46c-210c.cloud.databricks.com", "/sql/1.0/warehouses/b785449970d46af7", [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]),
				    workspace_Database = Source{[Name="workspace",Kind="Database"]}[Data],
				    default_Schema = workspace_Database{[Name="default",Kind="Schema"]}[Data],
				    events_enriched_Table = default_Schema{[Name="events_enriched",Kind="Table"]}[Data]
				in
